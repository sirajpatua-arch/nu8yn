{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "GOOGLE_API_KEY": "GOOGLE_API_KEY",
    "GROQ_API_KEY_1": "GROQ_API_KEY_1",
    "GROQ_API_KEY_2": "GROQ_API_KEY_2",
    "GROQ_API_KEY_3": "GROQ_API_KEY_3",
    "GROQ_MODEL": "GROQ_MODEL"
  }
}